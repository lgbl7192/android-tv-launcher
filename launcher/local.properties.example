# Copy this file to local.properties (gitignored) and fill it in.

# Path to the Android SDK. Android Studio installs it here on a Mac; on Windows it's usually
# C\:\\Users\\<you>\\AppData\\Local\\Android\\Sdk. You can set ANDROID_HOME instead.
sdk.dir=/Users/<you>/Library/Android/sdk

# Optional: a "Sports" row with live scores from ESPN (no key needed). Leave both empty to hide it.
# Leagues: nfl, nba, wnba, mlb, nhl, cfb (college football), cbb (men's college basketball), mls, epl
sports.leagues=
# Your teams, shown first: league:ESPN abbreviation, e.g. nfl:TEN,nba:GSW,epl:EVE. Their leagues are added automatically.
sports.teams=
